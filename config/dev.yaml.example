# 开发环境配置
# 复制为 config/dev.yaml 并按需调整

port: 8093
log_level: debug
log_dir: logs
log_rotation:
  max_size_mb: 20
  max_backups: 7
  max_age_days: 7
  compress: true

jwt_secret: dev-secret-not-for-production

crawler:
  exec_on_startup: false
  worker_num: 2
  # 兼容配置键：连接 scrapio-browser 的 gRPC 地址
  drission_rod_grpc_ip: "127.0.0.1"
  drission_rod_grpc_port: 8191

db:
  dsn: "postgres://dev:dev@localhost:5432/scrapio_dev?sslmode=disable"

# 手动 AI 规则建议；默认关闭。base_url 为兼容 Chat Completions 的完整 HTTPS URL。
ai_assist:
  enabled: false
  base_url: ""
  model: ""
  max_requests_per_day: 10
  # api_key: 通过 AI_ASSIST_API_KEY 环境变量设置
