# 生产环境配置
# 复制为 config/prod.yaml 并按需调整

port: 8093
log_level: warn
log_dir: logs
log_rotation:
  max_size_mb: 20
  max_backups: 7
  max_age_days: 7
  compress: true

# jwt_secret: 建议通过环境变量 JWT_SECRET 设置

crawler:
  exec_on_startup: true
  worker_num: 8
  # 兼容配置键：连接 scrapio-browser，Compose 通过环境变量设置
  # drission_rod_grpc_ip: "scrapio-browser"
  # drission_rod_grpc_port: 8191

db:
  dsn: ""  # 通过环境变量 DB_DSN 设置

# 手动 AI 规则建议；启用时用环境变量提供端点、模型、密钥及每日请求上限。
ai_assist:
  enabled: false
  max_requests_per_day: 10
